[Unit]
Description=Create and verify encrypted Atlas PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=atlas-backup
RuntimeDirectoryMode=0700
Environment=GNUPGHOME=/run/atlas-backup
ExecStart=/usr/local/sbin/atlas-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/atlas/backups/encrypted /run/lock
ReadOnlyPaths=/opt/atlas/app
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN
LockPersonality=true
RestrictSUIDSGID=true
