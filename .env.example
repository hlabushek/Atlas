ATLAS_OWNER_PASSWORD=replace-with-a-long-unique-password
ATLAS_SESSION_SECRET=replace-with-at-least-32-random-characters
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas
ATLAS_MODEL_PROVIDER=demo
ATLAS_MODEL_URL=http://host.docker.internal:11434/v1
ATLAS_MODEL_NAME=your-installed-model
ATLAS_MODEL_API_KEY=
ATLAS_MAX_OUTPUT_TOKENS=1024
ATLAS_COOKIE_SECURE=false

ATLAS_TELEGRAM_BOT_TOKEN=
# ATLAS_TELEGRAM_PROXY=socks5://user:password@host:port
# ATLAS_TELEGRAM_OWNER_ID=123456789
# Опционально: RouterAI STT. Тариф модели Universal-3.5 Pro указан в копейках за минуту.
ATLAS_TELEGRAM_STT_MODEL=assemblyai/universal-3-5-pro
ATLAS_TELEGRAM_STT_KOPECKS_PER_MINUTE=41
ATLAS_INTEGRATION_HOSTS=
# Ключ Fernet для зашифрованных сессий сайтов. Создайте отдельно и храните только в окружении VPS.
ATLAS_CONNECTOR_SESSION_KEY=
# Отдельный случайный токен внутреннего сервиса Chromium (32+ символа).
ATLAS_BROWSER_SERVICE_TOKEN=

# Optional gateway, run manually with your PKI (paths outside Git):
# ATLAS_DESKTOP_CERT=C:/private/atlas/server.pem
# ATLAS_DESKTOP_KEY=C:/private/atlas/server.key
# ATLAS_DESKTOP_CA=C:/private/atlas/ca.pem
# ATLAS_DESKTOP_HOST=127.0.0.1
# ATLAS_DESKTOP_PORT=8443

# Опциональный реальный embedding provider 768; пустые значения отключают семантический поиск.
ATLAS_EMBEDDING_URL=
ATLAS_EMBEDDING_MODEL=
ATLAS_EMBEDDING_API_KEY=
# Опциональный зашифрованный Web Push; private key нельзя вставлять в интерфейс/чат.
ATLAS_VAPID_PRIVATE_KEY=
ATLAS_VAPID_PUBLIC_KEY=
ATLAS_VAPID_SUBJECT=
ATLAS_PUSH_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com

ATLAS_ROUTERAI_API_KEY=

ATLAS_PLUSVIBE_API_KEY=
